{
  "name": "zelda-rag-api",
  "version": "1.0.0",
  "description": "REST API with RAG (Retrieval-Augmented Generation) on The Legend of Zelda universe using TypeScript and LangChain",
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "ingest": "tsx scripts/ingest.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "zelda",
    "rag",
    "langchain",
    "typescript",
    "embeddings",
    "vectorstore",
    "rest-api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.2.13",
    "@langchain/openai": "^1.6.0",
    "@langchain/textsplitters": "^1.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "langchain": "^1.5.14",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.1",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
